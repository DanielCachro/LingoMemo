// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum SourceLanguages {
  en
}

enum TargetLanguages {
  ca
  zh
  cs
  nl
  en
  eo
  fi
  fr
  gl
  de
  el
  hu
  it
  ja
  la
  lv
  mk
  cmn
  nb
  nn
  ang
  pl
  pt
  ro
  ru
  sh
  es
  sv
  mul
}

model User {
  id                      String            @id
  name                    String
  email                   String            @unique
  timeZone                String
  utcOffsetMinutes        Int
  preferences             Preferences?
  learningProfiles        LearningProfile[]
  activeLearningProfileId Int?              @unique
  activeLearningProfile   LearningProfile?  @relation("ActiveLearningProfile", fields: [activeLearningProfileId], references: [id])
}

model Preferences {
  id     Int    @id @default(autoincrement())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LearningProfile {
  id                     Int                  @id @default(autoincrement())
  profileName            String?
  sourceLang             SourceLanguages?
  targetLang             TargetLanguages?
  streakCount            Int                  @default(0)
  longestStreak          Int                  @default(0)
  userId                 String
  user                   User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeForUser          User?                @relation("ActiveLearningProfile")
  flashcards             Flashcard[]
  FlashcardReviewLog     FlashcardReviewLog[]
  FlashcardCompletionLog StudyCompletionLog[]

  @@unique([userId, sourceLang, targetLang])
  @@unique([userId, profileName])
}

model AnswerLicense {
  id         Int    @id @default(autoincrement())
  name       String
  licenseUrl String
  sourceUrl  String
  answerId   Int    @unique
  answer     Answer @relation(fields: [answerId], references: [id], onDelete: Cascade)
}

model Answer {
  id         Int            @id @default(autoincrement())
  text       String
  phonetic   String?
  audio      String[]
  isPersonal Boolean        @default(false)
  license    AnswerLicense?
  flashcards Flashcard[]
}

model Flashcard {
  id                 Int                  @id @default(autoincrement())
  question           String
  note               String?
  examples           String[]
  synonyms           String[]
  eFactor            Float                @default(2.5)
  interval           Int                  @default(0)
  createdAt          DateTime             @default(now())
  nextReview         DateTime?            @default(now())
  answerId           Int
  answer             Answer               @relation(fields: [answerId], references: [id])
  learningProfileId  Int
  learningProfile    LearningProfile      @relation(fields: [learningProfileId], references: [id], onDelete: Cascade)
  FlashcardReviewLog FlashcardReviewLog[]

  @@index([learningProfileId, nextReview])
}

model FlashcardReviewLog {
  id                Int             @id @default(autoincrement())
  flashcardId       Int
  flashcard         Flashcard       @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  learningProfileId Int
  learningProfile   LearningProfile @relation(fields: [learningProfileId], references: [id], onDelete: Cascade)
  reviewedAt        DateTime        @default(now())
  eFactor           Float

  @@unique([flashcardId, learningProfileId, reviewedAt])
  @@index([flashcardId, reviewedAt])
  @@index([learningProfileId, reviewedAt])
}

model StudyCompletionLog {
  id                Int             @id @default(autoincrement())
  completedAt       DateTime        @default(now())
  learningProfileId Int
  learningProfile   LearningProfile @relation(fields: [learningProfileId], references: [id], onDelete: Cascade)

  @@unique([learningProfileId, completedAt])
}
