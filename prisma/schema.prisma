// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Theme {
  Light
  Dark
  Automatic
}

enum SourceLanguages {
  en
}

enum TargetLanguages {
  ca
  zh
  cs
  nl
  en
  eo
  fi
  fr
  gl
  de
  el
  hu
  it
  ja
  la
  lv
  mk
  cmn
  nb
  nn
  ang
  pl
  pt
  ro
  ru
  sh
  es
  sv
  mul
}

model User {
  id               String            @id
  name             String
  email            String            @unique
  preferences      Preferences?
  learningProfiles LearningProfile[]
  activeLearningProfileId Int?
  activeLearningProfile   LearningProfile?  @relation("ActiveProfile", fields: [activeLearningProfileId], references: [id])
}

model Preferences {
  id     Int    @id @default(autoincrement())
  theme  Theme
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])
}

model LearningProfile {
  id         Int             @id @default(autoincrement())
  sourceLang SourceLanguages
  targetLang TargetLanguages
  users      User[]
  activeForUsers User[] @relation("ActiveProfile")

  @@unique([sourceLang, targetLang])
}
